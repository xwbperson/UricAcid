NODE_ENV=development
PORT=4317
DATA_DIR=./data
SHARED_PASSWORD_HASH=
SESSION_DAYS=365
# Production snapshot encryption key; keep it separate from backup files.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_VERSION=v1
# Optional second disk/server directory. Leave empty until it is a private mounted path.
BACKUP_REPLICA_DIR=
BACKUP_RETENTION=7

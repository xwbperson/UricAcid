{
  "name": "uric-acid-observation-desk",
  "version": "0.1.0",
  "private": true,
  "description": "手机优先的饮食、饮品和血尿酸趋势记录系统",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "c8 npm test",
    "setup:password": "node dist/scripts/setup-password.js",
    "db:reset": "node dist/scripts/reset-db.js",
    "backup:once": "node dist/scripts/backup-once.js",
    "restore:snapshot": "node dist/scripts/restore-snapshot.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "c8": "^10.1.3",
    "playwright": "^1.62.1",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
